{
  "name": "grace-platform",
  "version": "1.0.0",
  "description": "GRACE - Growth, Relationships, Attendance, Community, Engagement. Church CRM that never loses a visitor.",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "tsx --env-file=.env.local api/_server.ts",
    "dev:full": "npm run dev:api & npm run dev --workspace=apps/admin-web",
    "lint": "eslint . --max-warnings 0",
    "lint:rls": "tsx tools/lint-rls.ts",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest",
    "test:run": "vitest run && npm run test:run --workspaces --if-present",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "@clerk/backend": "^3.17.1",
    "@clerk/clerk-react": "^5.61.9",
    "@floating-ui/react-dom": "^2.1.9",
    "@google/genai": "^2.21.0",
    "@sentry/node": "^10.73.0",
    "@sentry/profiling-node": "^10.73.0",
    "@sentry/react": "^10.73.0",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.11.0",
    "@supabase/supabase-js": "^2.115.0",
    "@types/qrcode": "^1.5.6",
    "cors": "^2.8.6",
    "date-fns": "^2.30.0",
    "express": "^5.2.1",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.0",
    "lucide-react": "^1.39.0",
    "posthog-js": "^1.427.2",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stripe": "^22.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vercel/node": "^12.0.1",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
